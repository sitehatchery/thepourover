# Copy to backend/.env and uncomment what you need to change. Defaults are shown.

# The brief's fixed "today" for every time-based rule.
# CDP_TODAY=2026-09-28

# Where the SQLite database and import reports live (default: <repo>/var, outside the web root).
# Use absolute paths.
# CDP_DATA_DIR=C:/wamp64/www/thepourover/var
# CDP_DATABASE_URL=sqlite:///C:/wamp64/www/thepourover/var/cdp.sqlite3

# Required secrets (no defaults). Generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CDP_JWT_SECRET=
# Comma-separated to rotate: the first signs, all are accepted.
CDP_WEBHOOK_SECRETS=

# AI assistant (OpenAI). CDP_OPENAI_API_KEY also works. Any current model with tool calling.
OPENAI_API_KEY=
# CDP_OPENAI_MODEL=gpt-5-mini
# CDP_OPENAI_REASONING_EFFORT=low

# Google Drive import (OAuth "Web application" client). Register this exact redirect URI in Google Cloud.
GOOGLE_OAUTH_CLIENT=
GOOGLE_OAUTH_SECRET=
# CDP_GOOGLE_REDIRECT_URI=http://localhost:8000/app/integrations/google/callback
# CDP_GOOGLE_DRIVE_FOLDER_ID=1teqRUXwm-ONYlw8KvgMBX0NHVflhkzHd
# CDP_APP_ORIGINS=https://cdp.local,http://localhost:5173

# Connect to Google/OpenAI over IPv4. Leave true unless the host has working IPv6.
# CDP_OUTBOUND_IPV4_ONLY=true

# Token lifetimes and limits.
# CDP_ACCESS_TOKEN_MINUTES=15
# CDP_REFRESH_TOKEN_DAYS=7
# CDP_COOKIE_SECURE=true
# CDP_LOGIN_ATTEMPTS_PER_MINUTE=10
# CDP_WEBHOOK_TOLERANCE_SECONDS=300
# CDP_WEBHOOK_REQUESTS_PER_MINUTE=600

# Folder the import reads CSVs from when Google Drive isn't connected (default: <repo>/data/sample).
# CDP_IMPORT_SOURCE_DIR=C:/wamp64/www/thepourover/data/sample
# CDP_IMPORT_BATCH_SIZE=10
