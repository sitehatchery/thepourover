{
  "info": {
    "name": "The Pour Over Mini CDP",
    "description": "Calls for the Mini CDP API. Set baseUrl, username, password and webhookSecret in a Postman environment (mark password and webhookSecret as secret), run 'Sign in', and every other request uses the token it saves. To use an API key instead, paste it into bearerToken. API keys are created, rotated and revoked in the admin console (/app/admin), not through the API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{bearerToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://thepourover.seedcast.ai"
    },
    {
      "key": "bearerToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "deviceId",
      "value": "d_postman1"
    },
    {
      "key": "userId",
      "value": "u_2b6447a3"
    },
    {
      "key": "segmentSlug",
      "value": "instagram_not_opened_30_days"
    },
    {
      "key": "profileId",
      "value": "s_1"
    },
    {
      "key": "lastEventId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Sign-in",
      "item": [
        {
          "name": "Health (no sign-in)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/app/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "app",
                "health"
              ]
            },
            "description": "Service status and the configured 'today'.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Sign in",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/app/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "app",
                "auth",
                "login"
              ]
            },
            "description": "Saves the access token (15 minutes) and refresh token into the collection.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const tokens = pm.response.json();",
                  "  pm.collectionVariables.set('bearerToken', tokens.access_token);",
                  "  pm.collectionVariables.set('refreshToken', tokens.refresh_token);",
                  "}",
                  "pm.test('Signed in', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh tokens",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/app/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "app",
                "auth",
                "refresh"
              ]
            },
            "description": "Swaps the refresh token for a new pair. Each refresh token works once.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const tokens = pm.response.json();",
                  "  pm.collectionVariables.set('bearerToken', tokens.access_token);",
                  "  pm.collectionVariables.set('refreshToken', tokens.refresh_token);",
                  "}",
                  "pm.test('Signed in', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Who am I",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/app/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "app",
                "auth",
                "me"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Sign out",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/app/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "app",
                "auth",
                "logout"
              ]
            },
            "description": "Ends the sign-in: the refresh token and every token rotated from it stop working.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
